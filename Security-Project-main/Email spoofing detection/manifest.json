{
  "manifest_version": 3,
  "name": "Email Spoofing Detector",
  "version": "0.1",
  "description": "Detects potential phishing attempts in emails",
  "key": "",

  "host_permissions": [
    "*://mail.google.com/*",
    "https://gmail.googleapis.com/*",
    "http://localhost:5000/*"
  ],

  "permissions": ["identity", "activeTab", "scripting", "tabs"],
  "oauth2": {
    "client_id": "569792691071-ammkkdatkq4dlbobg39m9nd8qk3l0bip.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://mail.google.com/*"],
      "js": ["content_script.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["modules/content/*.js"],
      "matches": ["*://mail.google.com/*"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "UI/images/icon16.png",
      "48": "UI/images/icon48.png",
      "128": "UI/images/icon128.png"
    }
  },

  "icons": {
    "16": "UI/images/icon16.png",
    "48": "UI/images/icon48.png",
    "128": "UI/images/icon128.png"
  }

}
